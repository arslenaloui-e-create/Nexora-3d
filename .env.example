# PostgreSQL Supabase (Prisma) — utiliser l'URI de connexion fournie par Supabase.
# Pour l'application sur Vercel, choisir le pooler recommandé par Supabase.
DATABASE_URL="postgresql://postgres:[MOT_DE_PASSE]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
# Optionnel : URI directe pour les migrations Prisma si DATABASE_URL utilise le pooler.
DIRECT_URL="postgresql://postgres:[MOT_DE_PASSE]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Obligatoire en production. Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
APP_URL="http://localhost:3000"

# Emails Resend (recommandé)
RESEND_API_KEY=""
EMAIL_FROM="Nexora 3D <noreply@votre-domaine-verifie.tld>"
ADMIN_NOTIFICATION_EMAIL=""

# Stockage des fichiers privés Supabase. Garder la clé service_role côté serveur uniquement.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_STORAGE_BUCKET="client-files"
SUPABASE_SERVICE_ROLE_KEY=""
MAX_UPLOAD_MB="50"

# Compatibilité facultative avec l'ancien envoi Gmail API.
GMAIL_USER=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Utilisés uniquement par npm run db:seed pour créer le premier admin si absent.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
