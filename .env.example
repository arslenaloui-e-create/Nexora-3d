# Base PostgreSQL (sur Railway : la variable DATABASE_URL du service Postgres)
DATABASE_URL="postgresql://nexora:nexora@localhost:5432/nexora3d?schema=public"

# OBLIGATOIRE en production : 32 caractères minimum, jamais la valeur d'exemple.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Adresse publique du site (liens dans les emails, sitemap)
APP_URL="http://localhost:3000"

# Emails (facultatif). Sans SMTP, le site fonctionne mais n'envoie aucun email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Nexora 3D <noreply@example.com>"
# Adresse qui reçoit les alertes (nouvelle demande, message de contact). Par défaut : SMTP_USER.
ADMIN_NOTIFY_EMAIL=""

# Fichiers clients : dossier de stockage. Sur Railway, monter un volume et pointer dessus
# (ex. /app/storage), sinon les fichiers sont effacés à chaque redéploiement.
STORAGE_DIR=""
MAX_UPLOAD_MB="50"

# Utilisés uniquement par "npm run db:seed" pour créer le premier admin (s'il n'existe pas déjà).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
